    "PATTERNS.md",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "docs/public/favicon-32.png",
    "docs/public/favicon-180.png",
    "codex-hooks.json",
    ".github/plugin/",
    "copilot-hooks.json",
    ".cursor-plugin/",
    "cursor-hooks.json",
    "cursor/",
    "gemini/",
    "qwen-extension.json",
    "qwen-hooks.json"
