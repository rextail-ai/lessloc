{
  "name": "lessloc",
  "version": "0.10.0",
  "description": "Keeps AI coding agents such as Claude Code, Codex, GitHub Copilot, Gemini CLI and Cursor to the least code that does the job and still works.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
