    "opencode",
    "amp",
    "cline",
    "pi-package",
    "ai-coding-agent",
    "coding-agent",
    "agent-hooks",
    "code-review",
    "code-quality",
    "dead-code",
    "duplicate-code",
    "llm"
  ],
  "homepage": "https://lessloc.org",
  "bugs": {
    "url": "https://github.com/rextail-ai/lessloc/issues"
  },
  "author": {
    "name": "lessloc",
    "url": "https://lessloc.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rextail-ai/lessloc.git"
  },
  "bin": {
    "lessloc": "lessloc.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preversion": "node scripts/version.mjs --check",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "lessloc.mjs",
    "hook.mjs",
    "lib/",
    "bridge/",
    "opencode/",
    "amp/",
    "augment/",
    "cline/",
