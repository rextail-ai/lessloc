{
  "host": "junie",
  "source": ["https://junie.jetbrains.com/docs/junie-cli-hooks.html"],
  "read": "2026-10-19",
  "evidence": false,
  "events": {
    "start": {"hook_event_name": "SessionStart", "session_id": "$SID", "cwd": "/home/user/.junie", "project_path": "$CWD", "source": "startup"},
    "prompt": {"hook_event_name": "UserPromptSubmit", "session_id": "$SID", "cwd": "/home/user/.junie", "project_path": "$CWD", "prompt": "$PROMPT"},
    "write": {"hook_event_name": "PreToolUse", "session_id": "$SID", "cwd": "/home/user/.junie", "project_path": "$CWD", "tool_name": "Write", "tool_input": {"file_path": "$ABSFILE", "content": "$CONTENT"}},
    "shell": {"hook_event_name": "PreToolUse", "session_id": "$SID", "cwd": "/home/user/.junie", "project_path": "$CWD", "tool_name": "Bash", "tool_input": {"command": "$COMMAND", "run_in_background": false}},
    "stop": {"hook_event_name": "Stop", "session_id": "$SID", "cwd": "/home/user/.junie", "project_path": "$CWD", "stop_hook_active": "$AGAIN", "last_assistant_message": "Done."}
  },
  "answer": {"context": "additionalContext", "deny": "hookSpecificOutput.permissionDecisionReason", "block": "reason"}
}
