{
  "host": "droid",
  "source": ["https://docs.factory.com/harness/hooks.md"],
  "read": "2026-10-19",
  "_verify": [
    "the arguments of ApplyPatch; the docs show only Create's (file_path, content) and Execute's (command), and Droid 0.247.0 sends Edit's as {file_path, old_str, new_str}"
  ],
  "events": {
    "start": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "SessionStart", "source": "startup"},
    "prompt": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "UserPromptSubmit", "prompt": "$PROMPT", "has_images": false},
    "write": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "PreToolUse", "tool_name": "Create", "tool_input": {"file_path": "$ABSFILE", "content": "$CONTENT"}},
    "written": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "PostToolUse", "tool_name": "Create", "tool_input": {"file_path": "$ABSFILE", "content": "$CONTENT"}, "tool_response": "{\"success\":true,\"file_path\":\"$ABSFILE\"}"},
    "shell": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "PreToolUse", "tool_name": "Execute", "tool_input": {"summary": "", "command": "$COMMAND", "riskLevel": "low"}},
    "ran": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "PostToolUse", "tool_name": "Execute", "tool_input": {"summary": "", "command": "$COMMAND", "riskLevel": "low"}, "tool_response": "$OUTPUT\n\n\n[Process exited with code $EXIT]"},
    "stop": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "permission_mode": "off", "hook_event_name": "Stop", "stop_hook_active": "$AGAIN", "tool_execution_count": 6, "elapsed_time": 42}
  },
  "answer": {"context": "hookSpecificOutput.additionalContext", "deny": "hookSpecificOutput.permissionDecisionReason|hookSpecificOutput.permissionDecision=deny", "ask": "hookSpecificOutput.permissionDecisionReason|hookSpecificOutput.permissionDecision=ask", "feedback": "hookSpecificOutput.additionalContext", "block": "reason"}
}
