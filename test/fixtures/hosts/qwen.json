{
  "host": "qwen",
  "source": ["https://github.com/QwenLM/qwen-code/blob/main/docs/users/features/hooks.md", "https://github.com/QwenLM/qwen-code/blob/main/packages/core/src/core/coreToolScheduler.ts", "https://github.com/QwenLM/qwen-code/blob/main/packages/core/src/tools/shell.ts", "https://github.com/QwenLM/qwen-code/blob/main/packages/core/src/tools/write-file.ts"],
  "read": "2026-10-19",
  "events": {
    "start": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "SessionStart", "timestamp": "$TIME", "permission_mode": "default", "source": "startup", "model": "qwen3-coder-plus"},
    "prompt": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "UserPromptSubmit", "timestamp": "$TIME", "permission_mode": "default", "prompt": "$PROMPT"},
    "write": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "PreToolUse", "timestamp": "$TIME", "permission_mode": "default", "tool_name": "write_file", "tool_input": {"file_path": "$ABSFILE", "content": "$CONTENT"}, "tool_use_id": "$ID"},
    "written": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "PostToolUse", "timestamp": "$TIME", "permission_mode": "default", "tool_name": "write_file", "tool_input": {"file_path": "$ABSFILE", "content": "$CONTENT"}, "tool_response": {"llmContent": "Successfully created and wrote to new file: $ABSFILE.", "returnDisplay": {"fileDiff": "Index: $FILE\n", "fileName": "$FILE", "filePath": "$ABSFILE", "originalContent": "", "newContent": "$CONTENT"}}, "tool_use_id": "$ID", "duration_ms": 4},
    "shell": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "PreToolUse", "timestamp": "$TIME", "permission_mode": "default", "tool_name": "run_shell_command", "tool_input": {"command": "$COMMAND", "description": "Run the tests"}, "tool_use_id": "$ID"},
    "ran": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "PostToolUse", "timestamp": "$TIME", "permission_mode": "default", "tool_name": "run_shell_command", "tool_input": {"command": "$COMMAND", "description": "Run the tests"}, "tool_response": {"llmContent": "Command: $COMMAND\nDirectory: (root)\nOutput: $OUTPUT\nError: (none)\nExit Code: $EXIT\nSignal: (none)\nProcess Group PGID: 4242", "returnDisplay": "$OUTPUT"}, "tool_use_id": "$ID", "duration_ms": 120},
    "stop": {"session_id": "$SID", "transcript_path": "/tmp/session.jsonl", "cwd": "$CWD", "hook_event_name": "Stop", "timestamp": "$TIME", "permission_mode": "default", "stop_hook_active": "$AGAIN", "last_assistant_message": "Done."}
  },
  "answer": {"context": "hookSpecificOutput.additionalContext", "deny": "hookSpecificOutput.permissionDecisionReason", "feedback": "hookSpecificOutput.additionalContext", "block": "reason"}
}
