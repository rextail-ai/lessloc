{
  "host": "codex",
  "source": ["https://developers.openai.com/codex/hooks"],
  "read": "2026-10-19",
  "events": {
    "start": {"hook_event_name":"SessionStart","session_id":"$SID","cwd":"$CWD","transcript_path":null,"model":"gpt-5","source":"startup"},
    "prompt": {"hook_event_name":"UserPromptSubmit","session_id":"$SID","turn_id":"t1","cwd":"$CWD","prompt":"$PROMPT"},
    "write": {"hook_event_name":"PreToolUse","session_id":"$SID","turn_id":"t1","cwd":"$CWD","tool_name":"apply_patch","tool_use_id":"$ID","tool_input":{"command":"$PATCH"}},
    "written": {"hook_event_name":"PostToolUse","session_id":"$SID","turn_id":"t1","cwd":"$CWD","tool_name":"apply_patch","tool_use_id":"$ID","tool_input":{"command":"$PATCH"},"tool_response":"Success. Updated the following files:\nA $FILE"},
    "shell": {"hook_event_name":"PreToolUse","session_id":"$SID","turn_id":"t1","cwd":"$CWD","tool_name":"Bash","tool_use_id":"$ID","tool_input":{"command":"$COMMAND"}},
    "ran": {"hook_event_name":"PostToolUse","session_id":"$SID","turn_id":"t1","cwd":"$CWD","tool_name":"Bash","tool_use_id":"$ID","tool_input":{"command":"$COMMAND"},"tool_response":"Process exited with code $EXIT\nOutput:\n$OUTPUT"},
    "stop": {"hook_event_name":"Stop","session_id":"$SID","turn_id":"t1","cwd":"$CWD","stop_hook_active":"$AGAIN","last_assistant_message":"Done."}
  },
  "answer": {"context":"hookSpecificOutput.additionalContext","deny":"hookSpecificOutput.permissionDecisionReason","feedback":"hookSpecificOutput.additionalContext","block":"reason"}
}
